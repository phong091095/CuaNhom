{
  "name": "@matadoor/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Engine tính toán MATADOOR: biểu thức, bóc tách một bộ cửa, tổng hợp dự án, tối ưu cắt, báo giá, định dạng số. TypeScript thuần, không phụ thuộc giao diện.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=85 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
